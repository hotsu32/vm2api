# Minimal control-plane repair; keep the deployed official UI/helpers/kernel payload.
ARG BASE_IMAGE=ghcr.io/dofastted/vm2api@sha256:1200a48924c4b1879b226847208e6615302879abc50d6f990bba99041b2640fa
FROM ${BASE_IMAGE}
ARG GIT_REVISION
LABEL org.opencontainers.image.revision=${GIT_REVISION}
LABEL tv.chatshare.vm2api.patch="kernel-stall-recovery"
COPY src/server.mjs /opt/vm2api/src/server.mjs
COPY src/lib/pool/pool-scheduler.mjs /opt/vm2api/src/lib/pool/pool-scheduler.mjs
COPY src/lib/pool/schedule-state.mjs /opt/vm2api/src/lib/pool/schedule-state.mjs
COPY src/lib/transport/go-worker-client.mjs /opt/vm2api/src/lib/transport/go-worker-client.mjs
COPY src/lib/transport/kernel-router.mjs /opt/vm2api/src/lib/transport/kernel-router.mjs
COPY src/lib/transport/kernel-watchdog.mjs /opt/vm2api/src/lib/transport/kernel-watchdog.mjs
COPY src/lib/transport/rust-kernel-client.mjs /opt/vm2api/src/lib/transport/rust-kernel-client.mjs
COPY src/lib/vm/slot-recovery.mjs /opt/vm2api/src/lib/vm/slot-recovery.mjs
RUN node --check src/server.mjs \
    && node --check src/lib/pool/pool-scheduler.mjs \
    && node --check src/lib/pool/schedule-state.mjs \
    && node --check src/lib/transport/go-worker-client.mjs \
    && node --check src/lib/transport/kernel-router.mjs \
    && node --check src/lib/transport/kernel-watchdog.mjs \
    && node --check src/lib/transport/rust-kernel-client.mjs \
    && node --check src/lib/vm/slot-recovery.mjs
